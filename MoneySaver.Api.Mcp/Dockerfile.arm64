# Build stage runs on the host's native architecture; only the runtime image is arm64.
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build-env
WORKDIR /app

COPY . ./
RUN dotnet restore "MoneySaver.Api.Mcp.csproj" -a arm64
RUN dotnet publish "MoneySaver.Api.Mcp.csproj" -c Release -a arm64 -o out /p:UseAppHost=false

FROM --platform=linux/arm64 mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build-env /app/out .
ENTRYPOINT ["dotnet", "MoneySaver.Api.Mcp.dll"]